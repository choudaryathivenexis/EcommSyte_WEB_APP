# Copy to `.env` and adjust. Auto-loaded by the Flask CLI when python-dotenv is installed.
# Never commit the real .env (it is git-ignored).

APP_ENV=production            # production | development | testing
SECRET_KEY=change-me

HOST=127.0.0.1
PORT=5000

# SITE_ROOT=/path/to/site     # defaults to the repository root
# USE_PROXY_FIX=true          # when running behind a reverse proxy (Render/Railway/Nginx)
# SEND_FILE_MAX_AGE_DEFAULT=86400
